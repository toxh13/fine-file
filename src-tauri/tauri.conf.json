{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fine-file",
  "version": "0.10.1",
  "identifier": "com.toxh13.fine-file",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "fine-file",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "toxh13",
    "shortDescription": "Fast file explorer with folder sizes and instant search",
    "copyright": "Copyright (c) 2026 toxh13",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NTNENDZEQTNGM0FBQ0UKUldUT3F2T2piZFJUaEJBY1lMeGVJVWtLczFhL0Y3eFp2SWhsaWZzaWZCWnJkd1hpUkp1QkJjeFcK",
      "endpoints": ["https://github.com/toxh13/fine-file/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
